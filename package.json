{
  "name": "@martinjlowm/grafana-cdk",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "docs/snippets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinjlowm/grafana-cdk.git"
  },
  "author": "martinjlowm <martinjlowm@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#@/*.ts": "./src/*.ts",
    "#@/*": "./src/*",
    "#$/*.ts": "./test/*.ts",
    "#$/*": "./test/*"
  },
  "scripts": {
    "build": "tsc",
    "docs": "node docs/build.cjs",
    "test": "bun test",
    "test:update": "bun test --update-snapshots",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit && tsc -p docs/snippets --noEmit",
    "lint": "treefmt --ci",
    "format": "treefmt"
  },
  "dependencies": {
    "@grafana/schema": "^11.4.0",
    "constructs": "^10.4.2"
  },
  "peerDependencies": {
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
