{
  "include": ["src/*"],
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "rootDir": "./src",
    "moduleResolution": "node16",
    "types": ["node"],
    "lib": ["es2022"],
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "customConditions": ["development"],
    // Specifiers name the file that exists, because this project executes in
    // place — see docs/explanation.md. `rewriteRelativeImportExtensions` is
    // what permits `allowImportingTsExtensions` while still emitting; it
    // rewrites nothing here, since every specifier goes through the package
    // `imports` map and TypeScript only rewrites *relative* paths.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "skipLibCheck": true
  }
}
